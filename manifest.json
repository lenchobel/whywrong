{
  "schema": 2,
  "permissions": ["storage.read", "storage.write", "llm.complete"],
  "required_executas": [],
  "optional_executas": [],
  "system_prompt_addendum": "The user has WhyWrong open. It helps students understand why they picked a wrong answer on a multiple-choice question, and it writes practice questions for the same trap. If the user asks about a missed exam question, suggest they paste it into the app. Do not answer exam questions for them.",
  "tags": ["study", "exams", "students", "reading"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "WhyWrong",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 560 },
        "default_size": { "w": 760, "h": 820 },
        "max_size": { "w": 1100, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": [],
      "chat": [],
      "llm": ["complete"],
      "storage": ["get", "set"]
    },
    "csp_overrides": {
      "img-src": ["'self'", "data:"],
      "font-src": ["'self'", "data:"],
      "style-src": ["'self'"],
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "seed_storage": {},
    "user_id": 1
  }
}
